---
import { slugify } from '../utils/slugify';

interface Props {
  name: string;
  price: number;
  image: string;
  description: string;
  id: number;
}

const { name, price, image, description, id } = Astro.props;
---

<article
  class="border border-white/10 bg-blue-900/40 hover:shadow-lg shadow-sm rounded-md p-3 overflow-hidden"
>
  <img src={image} alt={name} class="aspect-square object-cover" />
  <h2 class="font-bold">{name}</h2>
  <p class="font-semibold text-neutral-900">${price}</p>
  <p>{description}</p>
  <a
    href={`/products/${id}`}
    class="inline-block bg-blue-600 text-white rounded px-4 py-2 mt-2"
    >Detalles</a
  >
</article>
