---
import { Image } from "astro:assets";
import heroBg from "../assets/hero_bg.png";
---

<section
  class="relative w-full min-h-screen bg-bg flex items-center overflow-hidden"
>
  <div
    class="absolute inset-0 lg:inset-y-0 lg:left-auto lg:right-30 w-full lg:w-[55%] z-0"
  >
    <Image
      src={heroBg}
      alt="Modelo con chaleco polar técnico premium frente a montañas nevadas"
      class="w-full h-full object-cover object-[center_50px]"
      loading="eager"
      quality={95}
    />
    <div class="absolute inset-0 bg-bg/80 lg:hidden"></div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-bg via-transparent to-bg hidden lg:block"
    >
    </div>
  </div>

  <div
    class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#08101e] to-transparent z-[1] pointer-events-none"
  >
  </div>

  <div
    class="relative z-10 w-full max-w-screen-xl mx-auto px-6 md:px-12 lg:px-2"
  >
    <div class="max-w-2xl pt-44 pb-20 lg:py-0">
      <h1
        class="font-display text-white leading-[0.95] text-6xl md:text-8xl lg:text-[7rem] tracking-tight"
      >
        Tecnología<br />
        <span
          class="font-sans font-light lowercase text-slate-300 text-4xl md:text-6xl tracking-wide block my-2 pl-2"
        >
          que te
        </span>
        <span class="text-brand">abraza</span>
      </h1>

      <div class="mt-10">
        <a
          href="/catalog"
          class="cursor-pointer bg-brand text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(244,84,28,0.5)] inline-block"
        >
          Explorar Colección
        </a>
      </div>
    </div>
  </div>

  <div
    class="absolute inset-y-0 right-0 w-full lg:w-[55%] hidden lg:block z-20"
  >
    <div class="absolute top-[38%] left-[28%] hero-floating-icon">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"
        ></path>
      </svg>
    </div>

    <div
      class="absolute top-[24%] right-[10%] hero-floating-icon"
      style="animation-delay: 1s;"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"
        ></path>
      </svg>
    </div>

    <div
      class="absolute bottom-[32%] right-[12%] hero-floating-icon"
      style="animation-delay: 2s;"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="2" x2="22" y1="12" y2="12"></line>
        <line x1="12" x2="12" y1="2" y2="22"></line>
        <path d="m20 16-4-4 4-4M4 8l4 4-4 4M16 4l-4 4-4-4M8 20l4-4 4 4"></path>
      </svg>
    </div>

    <div
      class="absolute right-6 top-1/2 -translate-y-1/2 flex flex-col gap-3 items-center"
    >
    </div>
  </div>
</section>
