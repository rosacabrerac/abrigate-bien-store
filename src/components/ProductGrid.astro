---
import { products } from "../data/products.ts";
import ProductCard from "./ProductCard.astro";
---

<section class="grid grid-cols-1 md:grid-cols-3 gap-6">
  {
    products.map((product) => (
      <ProductCard
        name={product.name}
        price={product.price}
        image={product.image}
        description={product.description}
        id={product.id}
        slug={product.slug}
      />
    ))
  }
</section>
