---
import { FAQ_LIST } from "../data/faq";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Preguntas Frecuentes | Abrígate Bien 🔥">
  <div class="max-w-screen-md mx-auto px-6 pt-32 pb-20">
    <p
      class="font-sans text-[10px] font-bold uppercase tracking-[0.2em] text-brand mb-2"
    >
      Ayuda & Soporte
    </p>
    <h1
      class="font-display text-white text-3xl md:text-4xl font-bold leading-tight mb-2"
    >
      Preguntas Frecuentes
    </h1>
    <p class="text-slate-400 mb-12">
      Todo lo que necesitás saber sobre tus compras, envíos y cambios.
    </p>

    <div class="divide-y divide-white/[0.06]">
      {
        FAQ_LIST.map((faq, index) => (
          <div
            class:list={{
              "pb-8": index === 0,
              "py-8": index > 0 && index < FAQ_LIST.length - 1,
              "pt-8": index === FAQ_LIST.length - 1,
            }}
          >
            <h3 class="text-base font-bold text-white">{faq.question}</h3>
            <p class="text-sm text-slate-400 mt-2 leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
