---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto | Abrígate Bien 🔥">
  <div class="max-w-screen-xl mx-auto px-6 pt-32 pb-20">
    <p
      class="font-sans text-[10px] font-bold uppercase tracking-[0.2em] text-brand mb-2"
    >
      Contacto
    </p>
    <h1
      class="font-display text-white text-3xl md:text-4xl font-bold leading-tight mb-2"
    >
      ¿Tenés alguna duda?
    </h1>
    <p class="text-slate-400 mb-12">
      Escribinos si tenés preguntas sobre talles, envíos o stock. Estamos para
      asesorarte.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-xl font-bold text-white mb-6">Escribinos</h2>
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="text-brand mt-0.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wider">
                Email
              </p>
              <a
                href="mailto:abrigatebien@gmail.com"
                class="text-sm font-medium text-white hover:text-brand transition-colors duration-200 mt-1 block"
              >
                abrigatebien@gmail.com
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="text-brand mt-0.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                class="h-5 w-5"
                viewBox="0 0 24 24"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 0 2.81.7A2 2 0 0 1 22 16.92"
                ></path></svg
              >
            </div>
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wider">
                Teléfono
              </p>
              <a
                href="tel:+59891000111"
                class="text-sm font-medium text-white/80 hover:text-brand transition-colors duration-200 mt-1 block"
              >
                +598 91 000 111
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="text-brand mt-0.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wider">
                Horario de atención
              </p>
              <p class="text-sm font-medium text-white mt-1">
                Lunes a Viernes de 9:00 a 18:00 hs
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="text-brand mt-0.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <p class="text-xs text-slate-500 uppercase tracking-wider">
                Área de Cobertura
              </p>
              <p class="text-sm font-medium text-white mt-1">
                Uruguay (Envíos a todo el país)
              </p>
            </div>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-xl font-bold text-white mb-6">
          Formulario de contacto
        </h2>
        <form>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
            <div>
              <label
                class="text-xs text-slate-500 uppercase tracking-wider mb-2 block"
                for="form-name">Nombre</label
              >
              <input
                type="text"
                id="form-name"
                name="form-name"
                class="w-full bg-slate-900/50 border border-border transition-colors duration-200 focus:border-brand focus:outline-none py-3 px-4 rounded-xl text-white"
              />
            </div>

            <div>
              <label
                class="text-xs text-slate-500 uppercase tracking-wider mb-2 block"
                for="form-email">Email</label
              >
              <input
                type="email"
                id="form-email"
                name="form-email"
                class="w-full bg-slate-900/50 border border-border transition-colors duration-200 focus:border-brand focus:outline-none py-3 px-4 rounded-xl text-white"
              />
            </div>
          </div>

          <div class="mb-5">
            <label
              class="text-xs text-slate-500 uppercase tracking-wider mb-2 block"
              for="form-msg">Mensaje</label
            >
            <textarea
              name="form-msg"
              id="form-msg"
              class="w-full h-32 bg-slate-900/50 border border-border transition-colors duration-200 focus:border-brand focus:outline-none py-3 px-4 rounded-xl text-white resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="bg-brand px-8 py-2.5 text-white font-bold rounded-xl hover:opacity-90 transition-opacity cursor-pointer"
            >Enviar</button
          >
        </form>
      </div>
    </div>
  </div>
</Layout>
